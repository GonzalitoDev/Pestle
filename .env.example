# Upstash Redis credentials used by the /api functions.
# On Vercel, add the "Upstash for Redis" integration (Storage tab) and these are injected automatically.
# For local development run `vercel env pull .env.local` and then `vercel dev`.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Optional: secret key for hashing owner ids and IPs (rate limiting). Any long random string.
# Generate one with: openssl rand -hex 32
OWNER_HASH_SECRET=""
