{
  "entities": {
    "pastes": {
      "title": "Paste",
      "description": "A shared code snippet or text block",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the paste" },
        "content": { "type": "string", "description": "The actual text/code" },
        "language": { "type": "string", "description": "Syntax highlighting language" },
        "userId": { "type": "string", "description": "ID of the creator" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "isPublic": { "type": "boolean", "description": "Visibility" }
      },
      "required": ["content", "language", "createdAt", "isPublic"]
    }
  },
  "firestore": {
    "/pastes/{pasteId}": {
      "schema": "pastes",
      "description": "Individual pastes"
    }
  }
}
